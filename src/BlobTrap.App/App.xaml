<Application x:Class="BlobTrap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Control styles only. The colour tokens they bind to with DynamicResource are
                    pushed in at startup by ThemeManager, which reads the live Windows theme and
                    accent and swaps them again whenever the user changes either.
                -->
                <ResourceDictionary Source="Theming/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
