<Window x:Class="BlobTrap.App.Views.QualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher qualidade" Height="660" Width="640"
        MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" Style="{StaticResource Subtitle}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionMuted}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ===================== Tracks ===================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="QUALIDADE" Style="{StaticResource SectionHeader}"
                               Margin="16,14,0,8"/>

                    <ListBox Grid.Row="1" x:Name="VideoList" Margin="8,0,8,10"
                             ItemContainerStyle="{StaticResource RowListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}"
                                               Style="{StaticResource CaptionMuted}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Audio track -->
            <Grid Grid.Row="1" x:Name="AudioRow" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Faixa de áudio" VerticalAlignment="Center"
                           Margin="2,0,14,0"/>
                <!-- An explicit ItemTemplate, not DisplayMemberPath: the latter is applied
                     through a template *selector*, which the closed box does not consult, so
                     the collapsed ComboBox would fall back to ToString() on the variant. -->
                <ComboBox Grid.Column="1" x:Name="AudioCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Subtitles -->
            <StackPanel Grid.Row="2" x:Name="SubtitleRow" Margin="0,16,0,0">
                <TextBlock Text="LEGENDAS" Style="{StaticResource SectionHeader}" Margin="2,0,0,6"/>
                <ItemsControl x:Name="SubtitleList" MaxHeight="96" Margin="2,0,0,0">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ===================== Output ===================== -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- A rule and its own header: sitting flush under the subtitle checkboxes with
                 the same indent, this reads as a third subtitle rather than a separate idea. -->
            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,14"/>

            <TextBlock Text="SAÍDA" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>

            <CheckBox x:Name="AudioOnlyCheck" Content="Baixar somente o áudio" Margin="2,0,0,0"
                      Checked="OnAudioOnlyChanged" Unchecked="OnAudioOnlyChanged"/>

            <TextBlock Text="SALVAR COMO" Style="{StaticResource SectionHeader}" Margin="2,14,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The box is narrower than most paths, so the full one lives in the tooltip. -->
                <TextBox Grid.Column="0" x:Name="OutputBox"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                        Margin="8,0,0,0" Click="OnBrowseClick" ToolTip="Escolher pasta e nome"/>
            </Grid>
        </StackPanel>

        <!-- ===================== Actions ===================== -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- A Grid, not a StackPanel: a horizontal stack gives its children unlimited
                 width, so the message would never wrap and would clip against the buttons. -->
            <Grid Grid.Column="0" x:Name="WarningPanel" VerticalAlignment="Center"
                  Margin="2,0,16,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13"
                           Foreground="{DynamicResource Warning}" VerticalAlignment="Top"
                           Margin="0,1,8,0"/>
                <TextBlock Grid.Column="1" x:Name="WarningText" Style="{StaticResource Caption}"
                           TextWrapping="Wrap"/>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Width="104" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Baixar" Width="124" Style="{StaticResource AccentButton}"
                        Click="OnConfirmClick" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
