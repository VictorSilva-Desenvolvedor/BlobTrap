<Window x:Class="BlobTrap.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:BlobTrap.App.ViewModels"
        Title="BlobTrap" Height="820" Width="1360"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusAddressCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BlobTrap" FontWeight="Bold" FontSize="15" Margin="4,0,16,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                    <Button Content="&#x2190;" Width="34" Click="OnBackClick" ToolTip="Voltar" Margin="0,0,4,0"/>
                    <Button Content="&#x2192;" Width="34" Click="OnForwardClick" ToolTip="Avancar" Margin="0,0,4,0"/>
                    <Button Content="&#x21BB;" Width="34" Click="OnReloadClick" ToolTip="Recarregar" Margin="0,0,10,0"/>
                </StackPanel>

                <TextBox Grid.Column="1" x:Name="AddressBox" VerticalAlignment="Center"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Ir" Width="46" Margin="0,0,8,0" Command="{Binding NavigateCommand}"/>
                    <Button Content="Baixar esta pagina" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DownloadCurrentPageCommand}" Margin="0,0,8,0"
                            ToolTip="Usa o yt-dlp para extrair o video da pagina atual"/>
                    <Button Content="Ferramentas" Click="OnToolsClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Browser + side panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="640"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 Grid.Column="0" x:Name="Browser"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"/>

            <TabControl Grid.Column="2" Background="{StaticResource Surface}" BorderThickness="0" Padding="0">

                <TabItem Header="Midias detectadas">
                    <Grid Background="{StaticResource Surface}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,6">
                            <Button Content="Limpar" Command="{Binding ClearCandidatesCommand}" Margin="0,0,8,0"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                                <Run Text="{Binding Candidates.Count, Mode=OneWay}"/>
                                <Run Text="item(ns)"/>
                            </TextBlock>
                        </StackPanel>

                        <ListBox Grid.Row="1" x:Name="CandidateList"
                                 ItemsSource="{Binding Candidates}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="8,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" CornerRadius="7" Background="{StaticResource SurfaceRaised}"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CandidateItem}">
                                    <Grid Margin="10,9">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border x:Name="Badge" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                    Background="{StaticResource BadgeOther}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Muted}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,7,0,2"
                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Host}" Style="{StaticResource Muted}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Url}"/>

                                            <Button Grid.Column="1" Content="Baixar" Style="{StaticResource PrimaryButton}"
                                                    Padding="14,4" FontSize="11"
                                                    Command="{Binding DataContext.DownloadCandidateCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding BadgeKey}" Value="Hls">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource BadgeHls}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BadgeKey}" Value="Dash">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource BadgeDash}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BadgeKey}" Value="File">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource BadgeFile}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BadgeKey}" Value="Audio">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource BadgeAudio}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Downloads">
                    <Grid Background="{StaticResource Surface}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,6">
                            <Button Content="Abrir pasta" Command="{Binding OpenDownloadFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Limpar concluidos" Command="{Binding ClearFinishedJobsCommand}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}" Background="Transparent"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="8,3"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="7" Background="{StaticResource SurfaceRaised}"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:JobItem}">
                                    <StackPanel Margin="10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="1" x:Name="State" Text="{Binding StateLabel}"
                                                       Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                                        </Grid>

                                        <ProgressBar Margin="0,8,0,6" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100" IsIndeterminate="{Binding IsIndeterminate}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DetailLabel}"
                                                       Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DetailLabel}"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Abrir" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.OpenJobFileCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Cancelar" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding CancelCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter TargetName="State" Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter TargetName="State" Property="Foreground" Value="{StaticResource Success}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" Margin="0,0,8,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ToolStatus}" Style="{StaticResource Muted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
