<Window x:Class="BlobTrap.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:BlobTrap.App.ViewModels"
        xmlns:conv="clr-namespace:BlobTrap.App.Converters"
        Title="BlobTrap" Height="860" Width="1420"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <conv:CountToVisibilityConverter x:Key="EmptyState"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusAddressCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Toolbar ===================== -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Divider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="4,0,18,0">
                    <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,9,0"
                            Background="{DynamicResource AccentFill}">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BlobTrap" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                            Click="OnBackClick" ToolTip="Voltar"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72A;"
                            Click="OnForwardClick" ToolTip="Avançar"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Click="OnReloadClick" ToolTip="Recarregar"/>
                </StackPanel>

                <!-- Address -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBox x:Name="AddressBox" Padding="34,0,10,0"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnAddressKeyDown"/>
                    <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Button Content="Ir" Width="48" Margin="0,0,8,0" Command="{Binding NavigateCommand}"/>
                    <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                            Command="{Binding DownloadCurrentPageCommand}"
                            ToolTip="Extrai o vídeo da página atual com o yt-dlp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Baixar esta página" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="{StaticResource CaptionSize}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                            Click="OnToolsClick" ToolTip="Ferramentas e preferências"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Browser + panel ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="410" MinWidth="330" MaxWidth="680"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 Grid.Column="0" x:Name="Browser"/>

            <!-- Stands in for the browser while reviewing the interface, so a screenshot shows
                 the panel against a neutral surface instead of an uninitialised white pane. -->
            <Border Grid.Column="0" Background="{DynamicResource AppBackground}"
                    Visibility="{Binding IsDesignSample, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="44"
                               Foreground="{DynamicResource TextTertiary}" Opacity="0.4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Área do navegador" Style="{StaticResource CaptionMuted}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" Background="{DynamicResource LayerBackground}">
                <TabControl>
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Margin" Value="18,4,18,0"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Detected media -->
                    <!-- The header is a panel, not text, so the accessible name is set here;
                         otherwise assistive tech announces the control's type name instead. -->
                    <TabItem AutomationProperties.Name="Mídias detectadas">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mídias"/>
                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,1,6,2"
                                        Background="{DynamicResource AccentFill}" VerticalAlignment="Center"
                                        Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyState}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding Candidates.Count}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="18,10,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12"
                                        Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyState}, ConverterParameter=invert}">
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding ClearCandidatesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpar" VerticalAlignment="Center"
                                                   FontSize="{StaticResource CaptionSize}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Empty state: the panel is blank until the user presses play,
                                 which is confusing unless we say so. -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,60"
                                        Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyState}}">
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}"
                                           FontSize="38" Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center" Opacity="0.55"/>
                                <TextBlock Text="Nenhuma mídia detectada" Style="{StaticResource BodyStrong}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource CaptionMuted}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="270"
                                           Margin="0,7,0,0" LineHeight="18"
                                           Text="Abra a página do vídeo e dê play. É o play que faz o player buscar o manifesto."/>
                            </StackPanel>

                            <ListBox Grid.Row="1" x:Name="CandidateList" ItemsSource="{Binding Candidates}"
                                     ItemContainerStyle="{StaticResource CardListItem}"
                                     Padding="0,0,4,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CandidateItem}">
                                        <Grid Margin="14,12,14,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <Border x:Name="Badge" Style="{StaticResource Badge}"
                                                        Background="{DynamicResource BadgeOther}">
                                                    <TextBlock Text="{Binding BadgeLabel}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource OnAccent}"/>
                                                </Border>
                                                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionMuted}"
                                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,10,0,0"
                                                       Style="{StaticResource BodyStrong}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Host}"
                                                           Style="{StaticResource CaptionMuted}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Url}"/>

                                                <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                                        Padding="14,5" MinHeight="28" FontSize="11"
                                                        Content="Baixar"
                                                        Command="{Binding DataContext.DownloadCandidateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding BadgeKey}" Value="Hls">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeHls}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BadgeKey}" Value="Dash">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeDash}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BadgeKey}" Value="File">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeFile}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BadgeKey}" Value="Audio">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeAudio}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BadgeKey}" Value="Subtitle">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeSubtitle}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Downloads -->
                    <TabItem Header="Downloads">
                        <Grid Margin="18,10,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource SubtleButton}" Margin="0,0,4,0"
                                        Command="{Binding OpenDownloadFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Abrir pasta" VerticalAlignment="Center"
                                                   FontSize="{StaticResource CaptionSize}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}"
                                        Command="{Binding ClearFinishedJobsCommand}"
                                        Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyState}, ConverterParameter=invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Limpar concluídos" VerticalAlignment="Center"
                                                   FontSize="{StaticResource CaptionSize}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,60"
                                        Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyState}}">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                           FontSize="38" Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center" Opacity="0.55"/>
                                <TextBlock Text="Nenhum download ainda" Style="{StaticResource BodyStrong}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource CaptionMuted}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="270"
                                           Margin="0,7,0,0" LineHeight="18"
                                           Text="O que você baixar aparece aqui, com progresso e velocidade."/>
                            </StackPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}"
                                     ItemContainerStyle="{StaticResource CardListItem}"
                                     Padding="0,0,4,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:JobItem}">
                                        <StackPanel Margin="14,12,14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           Style="{StaticResource BodyStrong}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}"/>

                                                <TextBlock Grid.Column="1" x:Name="State" Text="{Binding StateLabel}"
                                                           Style="{StaticResource Caption}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <ProgressBar Margin="0,11,0,9" Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding DetailLabel}"
                                                           Style="{StaticResource CaptionMuted}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DetailLabel}"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Padding="12,4" MinHeight="26" FontSize="11"
                                                            Margin="8,0,0,0" Content="Abrir"
                                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.OpenJobFileCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Padding="12,4" MinHeight="26" FontSize="11"
                                                            Margin="8,0,0,0" Content="Tentar de novo"
                                                            ToolTip="Reenfileira com a mesma qualidade e o mesmo destino"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding RetryCommand}"/>
                                                    <Button Padding="12,4" MinHeight="26" FontSize="11"
                                                            Margin="8,0,0,0" Content="Cancelar"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding CancelCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Success}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2" Padding="16,7" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Divider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,9,0"
                            VerticalAlignment="Center" Background="{DynamicResource AccentFill}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                               Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ToolStatus}" Style="{StaticResource CaptionMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
