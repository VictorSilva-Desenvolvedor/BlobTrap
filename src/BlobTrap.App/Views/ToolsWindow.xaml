<Window x:Class="BlobTrap.App.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ferramentas e preferencias" Height="560" Width="560"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tools -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceRaised}" CornerRadius="8"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
            <StackPanel>
                <TextBlock Text="MOTORES EXTERNOS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ffmpeg" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="InstallFfmpegButton" Content="Instalar"
                            Width="110" Click="OnInstallFfmpegClick" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="yt-dlp" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock x:Name="YtDlpStatus" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="InstallYtDlpButton" Content="Instalar"
                            Width="110" Click="OnInstallYtDlpClick" VerticalAlignment="Center"/>
                </Grid>

                <ProgressBar x:Name="InstallProgress" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="InstallStatus" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Download folder -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="PASTA DE DOWNLOADS" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="FolderBox"/>
                <Button Grid.Column="1" Content="..." Width="40" Margin="8,0,0,0" Click="OnBrowseFolderClick"/>
            </Grid>
        </StackPanel>

        <!-- Preferences -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="PREFERENCIAS" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

            <CheckBox x:Name="HideSmallCheck"
                      Content="Ocultar arquivos pequenos (menos de 512 KB)"/>
            <CheckBox x:Name="IncludeAudioCheck" Content="Listar arquivos de audio"/>
            <CheckBox x:Name="IncludeSubtitlesCheck" Content="Listar legendas"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Downloads simultaneos" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox Grid.Column="1" x:Name="ConcurrencyCombo" Width="80"/>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           Text="Segmentos em paralelo por download"/>
                <ComboBox Grid.Column="1" x:Name="SegmentCombo" Width="80"/>
            </Grid>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="O BlobTrap nao remove protecao DRM. Streams com Widevine, PlayReady ou FairPlay sao identificados e recusados."/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fechar" Width="100" Margin="0,0,8,0" Click="OnCloseClick"/>
            <Button Content="Salvar" Width="120" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
