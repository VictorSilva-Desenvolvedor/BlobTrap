<Window x:Class="BlobTrap.App.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ferramentas e preferências" Height="740" Width="600"
        MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== External engines ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Text="MOTORES EXTERNOS" Style="{StaticResource SectionHeader}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE714;" Style="{StaticResource Glyph}"
                               FontSize="18" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ffmpeg" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="FfmpegStatus" Style="{StaticResource CaptionMuted}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="InstallFfmpegButton" Content="Instalar"
                            Width="112" Click="OnInstallFfmpegClick" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE774;" Style="{StaticResource Glyph}"
                               FontSize="18" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="yt-dlp" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="YtDlpStatus" Style="{StaticResource CaptionMuted}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="InstallYtDlpButton" Content="Instalar"
                            Width="112" Click="OnInstallYtDlpClick" VerticalAlignment="Center"/>
                </Grid>

                <ProgressBar x:Name="InstallProgress" Margin="0,16,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="InstallStatus" Style="{StaticResource CaptionMuted}"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===================== Preferences ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="PASTA DE DOWNLOADS" Style="{StaticResource SectionHeader}" Margin="2,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="FolderBox"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                            Margin="8,0,0,0" Click="OnBrowseFolderClick" ToolTip="Escolher pasta"/>
                </Grid>

                <TextBlock Text="O QUE LISTAR" Style="{StaticResource SectionHeader}" Margin="2,22,0,7"/>
                <CheckBox x:Name="HideSmallCheck" Margin="2,3"
                          Content="Ocultar vídeos muito pequenos (menos de 64 KB)"/>
                <CheckBox x:Name="IncludeAudioCheck" Margin="2,3" Content="Listar arquivos de áudio"/>
                <CheckBox x:Name="IncludeSubtitlesCheck" Margin="2,3" Content="Listar legendas"/>

                <TextBlock Text="DESEMPENHO" Style="{StaticResource SectionHeader}" Margin="2,22,0,10"/>

                <Grid Margin="2,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Downloads simultâneos"/>
                        <TextBlock Style="{StaticResource CaptionMuted}" Margin="0,2,0,0"
                                   Text="Quantos vídeos baixam ao mesmo tempo."/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" x:Name="ConcurrencyCombo" Width="86" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Segmentos em paralelo"/>
                        <TextBlock Style="{StaticResource CaptionMuted}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="Pedaços buscados de uma vez em cada stream. Mais é rápido, mas pesa na rede."/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" x:Name="SegmentCombo" Width="86" VerticalAlignment="Center"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,22,0,0"
                        Background="{DynamicResource LayerBackground}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="15"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Top" Margin="0,1,12,0"/>
                        <TextBlock Style="{StaticResource CaptionMuted}" TextWrapping="Wrap"
                                   MaxWidth="440" LineHeight="18"
                                   Text="O BlobTrap não remove proteção DRM. Streams com Widevine, PlayReady ou FairPlay são identificados no manifesto e recusados."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Actions ===================== -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- A versao do app nao aparecia em lugar nenhum, e e' a primeira pergunta de
                 qualquer relato de bug - a unica que o usuario nao conseguia responder. -->
            <TextBlock Grid.Column="0" x:Name="AppVersionText" Style="{StaticResource CaptionMuted}"
                       VerticalAlignment="Center" Margin="2,0,0,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fechar" Width="104" Margin="0,0,8,0" Click="OnCloseClick"/>
            <Button Content="Salvar" Width="124" Style="{StaticResource AccentButton}"
                    Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
